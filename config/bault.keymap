#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Homerow Mods";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        Esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        Tap {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        Layer2 {
            bindings = <&lt 2 SPACE>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q  &kp W             &kp E             &kp R        &kp T  &kp Y      &kp U  &kp I          &kp O          &kp P            &kp BACKSPACE
&kp A  &kp S             &kp D             &kp F        &kp G  &kp H      &kp J  &kp K          &kp L          &kp ENTER
&kp Z  &kp X             &kp C             &kp V        &kp B  &kp N      &kp M  &kp COMMA      &kp PERIOD     &kp RIGHT_SHIFT
&none  &kp LEFT_CONTROL  &kp LEFT_CONTROL  &lt 1 SPACE         &kp SPACE         &kp RIGHT_ALT  &kp RIGHT_ALT  &none
            >;
        };

        layer_1 {
            bindings = <
&kp N1          &kp N2            &kp N3             &kp N4                &kp N5  &kp N6  &kp N7     &kp N8          &kp N9           &kp N0        &kp GRAVE
&kp CAPS        &kp MINUS         &kp EQUAL          &trans                &trans  &trans  &trans     &kp SEMICOLON   &kp SQT          &mo 2
&kp LEFT_SHIFT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &trans  &trans  &kp SLASH  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp UP_ARROW
&kp N0          &trans            &trans             &trans                        &trans             &kp DOWN_ARROW  &kp DOWN_ARROW   &kp N0
            >;
        };

        connectivity {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bootloader
&trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &bt BT_CLR    &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &trans
&kp N0  &trans  &trans  &trans          &trans                      &trans        &trans        &kp N0
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans          &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans          &trans  &trans  &trans
            >;
        };
    };
};
